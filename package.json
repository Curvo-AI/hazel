{
  "name": "hazel-server",
  "version": "5.1.1",
  "main": "lib/index.js",
  "description": "Lightweight update server for Electron apps",
  "scripts": {
    "dev": "npx vercel dev",
    "dev:local": "node -e 'const http = require(\"http\"); const handler = require(\"./lib/server\"); const PORT = process.env.PORT || 8080; const server = http.createServer(handler); server.listen(PORT, () => console.log(`Server running on port ${PORT}`));'",
    "test": "oxlint --deny-warnings && jest",
    "aws:build": "sam build",
    "aws:deploy": "sam deploy --guided",
    "aws:deploy:fast": "sam build && sam deploy",
    "aws:deploy:now": "sam build && sam deploy --no-confirm-changeset",
    "aws:local": "sam local start-api --env-vars env.json",
    "aws:logs": "sam logs -n HazelFunction --stack-name hazel-update-server --tail",
    "e2e": "bash e2e/run.sh",
    "e2e:parity": "bash e2e/run.sh parity"
  },
  "license": "MIT",
  "repository": "vercel/hazel",
  "dependencies": {
    "@aws-sdk/client-ssm": "3.1157.0",
    "async-retry": "1.3.3",
    "date-fns": "1.29.0",
    "express-useragent": "2.2.3",
    "finalhandler": "2.1.1",
    "handlebars": "4.7.10",
    "micro": "10.0.1",
    "ms": "2.1.3",
    "router": "2.2.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "oxlint": "1.89.0"
  },
  "engines": {
    "node": ">=20"
  }
}
